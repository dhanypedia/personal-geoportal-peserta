# Salin berkas ini menjadi .env, lalu isi nilainya.
# Jangan pernah commit .env yang sudah terisi.
#
# Buat dua nilai acak dengan salah satu perintah berikut:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"


# WAJIB. Tanpa bagian ini portal tidak bisa login.

# Ambil dari tombol Connect di dashboard Supabase, pilih ORM/Prisma.
# Pakai Session pooler port 5432. Nama penggunanya postgres.<ref>, bukan postgres.
# Transaction pooler port 6543 wajib diakhiri ?pgbouncer=true.
# Koneksi langsung db.<ref>.supabase.co sering gagal karena hostnya hanya IPv6.
# Karakter khusus pada kata sandi ditulis dalam bentuk persen: %40 dan %23.
# DIRECT_URL tidak dipakai, karena tabel dibuat lewat skrip di sql/.
DATABASE_URL=

# Menandatangani access token di lib/auth/jwt.js.
JWT_SECRET=

# Sesi NextAuth. Hasilnya harus BERBEDA dari JWT_SECRET.
NEXTAUTH_SECRET=

# Tanpa slash di akhir. Di VM menjadi http://IP_EKSTERNAL_VM/portal.
NEXTAUTH_URL=http://localhost:3000/portal

# Ditampilkan ke pengguna saat akunnya belum diaktifkan.
ADMIN_CONTACT_EMAIL=

# Dari https://ion.cesium.com/tokens.
# Nilai ini ditanam saat build, bukan dibaca saat aplikasi berjalan. Untuk
# build Docker, kirim juga sebagai _CESIUM_ION_TOKEN pada trigger Cloud Build,
# sebab .dockerignore mengecualikan .env dari build context.
NEXT_PUBLIC_CESIUM_ION_TOKEN=


# NILAI BAWAAN. Biasanya tidak perlu diubah.

# Jangan dikosongkan, karena token tanpa masa berlaku ditolak.
JWT_EXPIRES_IN=1h

# Diisi otomatis oleh Cloud Build pada deploy pertama. Sebelum itu, pakai nama
# image yang benar-benar ada. Nama karangan gagal "pull access denied", dan
# nilai kosong menggagalkan seluruh perintah docker compose, termasuk yang
# hanya menyalakan geoserver.
NEXTJS_IMAGE=nginx:1.27-alpine

AUTH_API_URL=http://localhost:3000/portal/api

# Samakan dengan NEXTAUTH_URL. Kalau kosong, alamat model 3D menjadi
# "undefined/api/..." dan modelnya gagal dibuka.
BASE_URL=http://localhost:3000/portal

# Sama dengan BASE_URL.
NEXT_PUBLIC_URL_BASE_PATH=http://localhost:3000/portal

# Kata sandi admin GeoServer, buat dengan perintah acak 16 byte supaya hanya
# berisi huruf dan angka. Jangan pakai tanda dolar, karena compose membacanya
# sebagai awal nama variabel dan sisa karakternya hilang tanpa peringatan.
GEOSERVER_ADMIN_PASSWORD=


# DATA SPASIAL. Hanya untuk unggah dan hapus layer katalog 2D.
# Tanpa bagian ini, login, Kelola Akun, Katalog 3D, dan halaman publik tetap
# berjalan. Yang gagal hanya dua endpoint di src/app/api/katalog-data-2d/.

# Koneksi langsung ke PostGIS lewat pustaka pg, bukan Prisma. Nilainya dipecah
# dari halaman Supabase yang sama dengan DATABASE_URL. Pakai port 5432.
POSTGIS_HOST=
POSTGIS_PORT=5432
POSTGIS_DB=postgres
POSTGIS_USER=
POSTGIS_PASSWORD=

# Schema tempat TABEL SPASIAL dibuat, dan harus sama dengan kolom "schema" pada
# datastore GeoServer. Buat dulu di SQL Editor Supabase:
#   CREATE SCHEMA IF NOT EXISTS gis;
# Ini BUKAN schema tempat PostGIS dipasang. PostGIS harus ada di schema public,
# karena GeoServer hanya menemukan postgis_lib_version() dari sana.
POSTGIS_SCHEMA=gis

# Alamat GeoServer untuk keperluan internal, dipakai aplikasi saat menerbitkan
# layer lewat REST API. Di VM pakai nama service geoserver, jangan localhost:
# di dalam container, localhost menunjuk ke container aplikasi sendiri dan
# gagal dengan "connection refused".
# Bila memasang GeoServer di laptop, ubah baris ini juga menjadi
# http://localhost:8080/geoserver. Mengubah GEOSERVER_PUBLIC_URL saja tidak
# cukup, dan gejalanya unggahan gagal dengan "fetch failed".
GEOSERVER_URL=http://geoserver:8080/geoserver
GEOSERVER_USERNAME=admin

# Harus sama persis dengan GEOSERVER_ADMIN_PASSWORD.
GEOSERVER_PASSWORD=

GEOSERVER_WORKSPACE=geoportal

# Nama datastore yang Anda buat sendiri di GeoServer, pada halaman
# Stores > Add new Store > PostGIS. Kosongkan di laptop, isi di VM setelah
# datastore-nya dibuat. Pelatihan ini memakai postgis_geoportal.
# Bila namanya tidak sama persis, unggahan gagal dengan "Could not find datastore".
GEOSERVER_POSTGIS_DATASTORE=

# Alamat GeoServer yang dilihat peserta, disimpan ke kolom wms_url dan wfs_url
# saat layer diterbitkan. Di VM wajib diisi http://IP_EKSTERNAL_VM/geoserver,
# dan nginx sudah mem-proxy /geoserver/ sehingga port 8080 tidak perlu dibuka.
# Di laptop, biarkan kosong bila GeoServer hanya ada di VM.
GEOSERVER_PUBLIC_URL=
