# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.worktrees/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

/public/data/models

/data

# Data GeoServer dibuat di VM, bukan bagian dari source code
/geoserver-data/

# Sertifikat TLS dan direktori tantangan Let's Encrypt dibuat di VM,
# bukan bagian dari source code.
/tls/
/certbot-webroot/

# Catatan aktivitas server pengembangan. Dibuat saat menjalankan npm run dev,
# dan isinya berubah setiap kali server dijalankan.
#
# Pola *.log menangkap seluruh berkas catatan, termasuk yang dibuat saat
# menjalankan server pada port lain untuk keperluan pengujian. Tanpa pola ini,
# berkas seperti dev3041.log ikut ter-commit dan ter-push tanpa disadari.
dev.log
*.log
